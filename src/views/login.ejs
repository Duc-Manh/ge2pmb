<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập</title>
  <!-- Favicon & Icons -->
  <link rel="shortcut icon" href="/images/favicon.ico/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon.ico/apple-icon-180x180.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.ico/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon.ico/favicon-16x16.png" />
  <link rel="manifest" href="/images/favicon.ico/manifest.json" />
  <!-- SEO & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" crossorigin="anonymous">
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/login.css?v=<%= Date.now() %>">
  <!-- Cloudflare Turnstile -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <!-- Tailwind CSS Production Build -->
  <link rel="stylesheet" href="/css/tailwind.min.css?v=<%= Date.now() %>">
</head>

<body id="vanta-bg" class="h-screen flex items-center justify-center">
  <!-- Xóa overlay đen để lộ rõ hiệu ứng Vanta -->

  <div id="auth-container"
    class="bg-white rounded-2xl w-full max-w-md p-8 shadow-2xl relative z-10 overflow-hidden transition-all duration-500">
    <!-- LOGIN VIEW -->
    <div id="login-view" class="transition-all duration-300">
      <a href="/" class="block text-center mb-8 cursor-pointer hover:opacity-80 transition-opacity duration-300">
        <img src="/images/logo-ngang.png" alt="EVNGENCO2 Logo" class="h-16 mx-auto mb-2">
        <h2 id="glitch-title" class="text-2xl font-bold text-evnBlue">Đăng nhập hệ thống</h2>
        <p class="text-sm text-gray-500 mt-1">Dành cho cán bộ quản lý dự án</p>
      </a>

      <form class="space-y-6" id="loginForm" action="/login" method="POST" onsubmit="return handleLogin(event, this)">
        <div class="relative group">
          <label
            class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-semibold text-evnBlue transition-colors group-hover:text-orange-600 group-focus-within:text-orange-600">Địa
            chỉ Email</label>
          <input type="email" name="email"
            class="w-full px-4 py-3 border-2 border-evnBlue rounded-lg outline-none transition-colors group-hover:border-orange-600 focus:border-orange-600 focus:ring-2 focus:ring-orange-600"
            placeholder="Nhập địa chỉ email của bạn" required>
        </div>
        <div class="relative group">
          <label
            class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-semibold text-evnBlue transition-colors group-hover:text-orange-600 group-focus-within:text-orange-600">Mật
            khẩu</label>
          <input type="password" name="password"
            class="w-full px-4 py-3 border-2 border-evnBlue rounded-lg outline-none transition-colors group-hover:border-orange-600 focus:border-orange-600 focus:ring-2 focus:ring-orange-600"
            placeholder="••••••••" required>
        </div>
        <div class="flex justify-center w-full">
          <div class="cf-turnstile" data-sitekey="<%= process.env.TURNSTILE_SITE_KEY || '0x4AAAAAADyn_9FkueOvBSqu' %>" data-theme="light"></div>
        </div>
        <div class="flex items-center justify-between mt-2">
          <label class="flex items-center">
            <input type="checkbox" class="w-4 h-4 text-evnBlue rounded border-gray-300 focus:ring-evnBlue">
            <span class="ml-2 text-sm text-gray-600">Ghi nhớ</span>
          </label>
          <a href="#" class="text-sm text-evnRed hover:underline font-medium">Quên mật khẩu?</a>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button"
            onclick="document.getElementById('login-view').classList.add('hidden'); document.getElementById('register-view').classList.remove('hidden'); document.getElementById('auth-container').classList.remove('max-w-md'); document.getElementById('auth-container').classList.add('max-w-3xl');"
            class="w-1/2 bg-white text-evnBlue border-2 border-evnBlue  font-bold py-3 px-4 rounded-lg transition-colors flex justify-center items-center gap-2 hover:border-orange-600 hover:bg-orange-600 hover:text-white">
            Đăng ký
          </button>
          <button type="submit"
            class="w-1/2 bg-evnBlue hover:bg-orange-600 text-white font-bold py-3 px-4 rounded-lg transition-colors shadow-md hover:shadow-lg flex justify-center items-center gap-2">
            Đăng nhập
          </button>
        </div>
      </form>
    </div>

    <!-- REGISTER VIEW -->
    <div id="register-view" class="hidden transition-all duration-300">
      <div class="text-center mb-8">

        <h2 id="typewriter-title" class="text-2xl font-bold text-evnBlue min-h-[2rem] flex items-center justify-center">
        </h2>
        <p class="text-sm text-gray-500 mt-1">Gia nhập hệ thống quản lý dự án</p>
      </div>

      <form class="grid grid-cols-1 md:grid-cols-2 gap-8" action="/register" method="POST"
        onsubmit="if(document.getElementById('captcha-verified').value !== 'true') { alert('Vui lòng kéo thanh trượt để ghép hình!'); return false; }">

        <!-- Cột trái: Thông tin tài khoản -->
        <div class="space-y-4">
          <div class="relative group">
            <label
              class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-semibold text-evnBlue transition-colors group-hover:text-orange-600 group-focus-within:text-orange-600">Địa
              chỉ Email</label>
            <input type="email" id="email" name="email"
              class="w-full px-4 py-3 border-2 border-evnBlue rounded-lg outline-none transition-colors group-hover:border-orange-600 focus:border-orange-600 focus:ring-2 focus:ring-orange-600"
              placeholder="Nhập địa chỉ email..." required>
          </div>
          <div class="relative group">
            <label
              class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-semibold text-evnBlue transition-colors group-hover:text-orange-600 group-focus-within:text-orange-600">Mật
              khẩu</label>
            <input type="password" id="password" name="password"
              class="w-full px-4 py-3 border-2 border-evnBlue rounded-lg outline-none transition-colors group-hover:border-orange-600 focus:border-orange-600 focus:ring-2 focus:ring-orange-600"
              placeholder="••••••••" required>
          </div>
          <div class="relative group">
            <label
              class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-semibold text-evnBlue transition-colors group-hover:text-orange-600 group-focus-within:text-orange-600">Xác
              nhận mật khẩu</label>
            <input type="password" name="confirm_password"
              class="w-full px-4 py-3 border-2 border-evnBlue rounded-lg outline-none transition-colors group-hover:border-orange-600 focus:border-orange-600 focus:ring-2 focus:ring-orange-600"
              placeholder="••••••••" required>
          </div>
        </div>

        <!-- Cột phải: Mã xác thực -->
        <div class="space-y-4 h-full flex flex-col justify-between">
          <div class="relative group">
            <label
              class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-semibold text-evnBlue transition-colors group-hover:text-orange-600 group-focus-within:text-orange-600 z-10">Mã
              xác thực (Kéo hình)</label>
            <div id="captcha-container"
              class="w-full h-full border-2 border-evnBlue rounded-lg p-2 flex flex-col gap-2 relative bg-white transition-colors hover:border-orange-600 focus-within:border-orange-600 focus-within:ring-2 focus-within:ring-orange-600">
              <!-- Ảnh nền & Mảnh ghép -->
              <div class="relative w-full flex-1 min-h-[7rem] bg-white rounded overflow-hidden select-none"
                id="captcha-image-wrapper">
                <!-- Dùng lại ảnh nền có sẵn của trang -->
                <img src="/images/logo-ngang.png" class="w-full h-full object-fill pointer-events-none" id="captcha-bg">
                <!-- Lỗ hổng -->
                <div id="captcha-hole"
                  class="absolute w-12 h-12 bg-black/50 border border-white/50 shadow-inner rounded-sm"
                  style="top: 20px; left: 150px;"></div>
                <!-- Mảnh ghép -->
                <div id="captcha-piece"
                  class="absolute w-12 h-12 border border-white shadow-lg rounded-sm bg-[url('/images/logo-ngang.png')]"
                  style="top: 20px; left: 10px; background-position: -150px -20px; background-size: 400px 128px;"></div>
              </div>
              <!-- Thanh trượt -->
              <div class="relative w-full h-12 bg-gray-50 rounded-lg border border-evnBlue overflow-hidden">
                <div id="slider-track" class="absolute top-0 left-0 h-full bg-blue-50 transition-colors"
                  style="width: 0;"></div>
                <div id="slider-btn"
                  class="absolute top-0 left-0 w-12 h-full bg-white border-r border-evnBlue shadow flex items-center justify-center cursor-pointer text-evnBlue hover:bg-evnBlue hover:text-white transition-colors z-10">
                  <!-- Icon mũi tên -->
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 pointer-events-none" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
                <div
                  class="absolute inset-0 w-full h-full flex items-center justify-center text-sm font-medium text-evnBlue pointer-events-none select-none z-0">
                  <span id="slider-text">Kéo thanh trượt để ghép hình</span>
                </div>
              </div>
              <!-- Trường ẩn để lưu trạng thái xác thực -->
              <input type="hidden" id="captcha-verified" name="captcha_verified" value="false" required>
            </div>
          </div>
        </div>

        <!-- Hàng Nút Bấm: Chiếm cả 2 cột và Căn giữa -->
        <div class="col-span-1 md:col-span-2 flex justify-center w-full mt-4">
          <div class="flex gap-4 w-full max-w-md">
            <button type="button"
              onclick="document.getElementById('register-view').classList.add('hidden'); document.getElementById('login-view').classList.remove('hidden'); document.getElementById('auth-container').classList.remove('max-w-3xl'); document.getElementById('auth-container').classList.add('max-w-md');"
              class="w-1/2 bg-white text-evnBlue border-2 border-evnBlue hover:bg-orange-600 hover:text-white hover:border-orange-600 font-bold py-3 px-4 rounded-lg transition-colors flex justify-center items-center gap-2">
              Quay lại
            </button>
            <button type="submit"
              class="w-1/2 bg-evnBlue hover:bg-orange-600 hover:text-white font-bold py-3 px-4 rounded-lg transition-colors shadow-md text-white flex justify-center items-center gap-2">
              Hoàn tất
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- tsParticles Background Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/tsparticles@2/tsparticles.bundle.min.js"></script>
  <script src="/js/login.js?v=<%= Date.now() %>"></script>

  <button onclick="window.location.href='/'" class="uiverse-btn z-50">
    <span class="actual-text">&nbsp;Quay lại&nbsp;</span>
    <span aria-hidden="true" class="hover-text" data-text="&nbsp;Quay lại&nbsp;">&nbsp;Quay lại&nbsp;</span>
  </button>
</body>

</html>