              </option>
              <option value="82_dong_thap" data-center="[105.698, 10.452]" data-zoom="9">
                Đồng Tháp
              </option>
              <option value="86_vinh_long" data-center="[105.973, 10.252]" data-zoom="9.5">
                Vĩnh Long
              </option>
              <option value="91_an_giang" data-center="[105.122, 10.525]" data-zoom="9">
                An Giang
              </option>
              <option value="92_can_tho" data-center="[105.783, 10.033]" data-zoom="9.5">
                Cần Thơ
              </option>
              <option value="96_ca_mau" data-center="[104.912, 9.175]" data-zoom="9">
                Cà Mau
              </option>
            </select>
          </div>
        </div>

        <!-- Split Grid (2 Columns) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" style="height: 70vh">
          <!-- Left Box: Vietnam National Map -->
          <div class="relative flex flex-col h-full">
            <div class="mb-2 text-left flex justify-between items-center">
              <span class="text-xs font-bold uppercase tracking-wider text-evnBlue">Bản đồ Toàn quốc</span>
            </div>

            <div class="flex-1 w-full rounded-xl overflow-hidden border border-slate-200 relative bg-[#f8fafc]">
              <div id="map-national-container" class="w-full h-full"></div>

              <!-- Collapsible Ward List Panel & Legend -->
              <div id="ward-list-panel"
                class="absolute top-1 right-1 bg-white/95 backdrop-blur-md rounded-xl shadow-lg border border-slate-200 z-10 flex flex-col w-60 max-h-[70%] transition-all duration-300">
                <!-- Panel Header -->
                <button id="toggle-ward-panel-btn"
                  class="flex justify-between items-center w-full p-2 font-semibold text-evnBlue border-b border-slate-100 hover:bg-slate-50 transition-colors rounded-t-xl">
                  <div class="flex items-center gap-1">
                    <span class="w-1 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                    <span class="text-xs uppercase tracking-wider font-bold">Danh sách Phường/Xã</span>
                  </div>
                  <!-- Arrow toggle icon -->
                  <svg id="ward-panel-arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                    stroke-width="2.5" stroke="currentColor"
                    class="w-4 h-4 text-slate-400 transition-transform duration-300 transform rotate-180">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                  </svg>
                </button>

                <!-- Panel Body -->
                <div id="ward-panel-body" class="flex-1 overflow-hidden flex flex-col transition-all duration-300">
                  <!-- Search input -->
                  <div class="p-2 border-b border-slate-100">
                    <input type="text" id="ward-search-input" placeholder="Tìm kiếm nhanh..."
                      class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-md focus:outline-none focus:border-blue-500 focus:bg-white" />
                  </div>

                  <!-- List element -->
                  <div id="ward-names-list" class="flex-1 overflow-y-auto p-2 space-y-1 max-h-[30vh]">
                    <!-- Fallback message when empty -->
                    <div id="ward-list-empty-state" class="text-center py-6 text-slate-400 text-xs">
                      Chưa chọn địa bàn tỉnh thành.
                    </div>
                  </div>
                </div>
              </div>

              <!-- Legend Overlay in the Bottom-Left -->
              <div
                class="absolute bottom-2 left-2 bg-white/90 backdrop-blur p-2.5 rounded-lg shadow border border-slate-100 text-left text-[9px] text-slate-500 space-y-1 z-10">
                <div class="font-semibold text-evnBlue mb-0.5 text-xs">
                  Bản đồ hành chính (2D)
                </div>
                <div class="flex items-center gap-1.5">
                  <span
                    class="w-2.5 h-2.5 rounded bg-gradient-to-r from-red-400 via-green-400 to-blue-400 inline-block"></span>
                  <span>Màu sắc riêng biệt theo tỉnh thành</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded bg-[#e2e8f0] border border-slate-300 inline-block"></span>
                  <span>Tỉnh thành khác (khi thu hẹp)</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Box: Detailed Province/Ward Map -->
          <div class="relative flex flex-col h-full">
            <div class="mb-2 text-left flex justify-between items-center">
              <span class="text-xs font-bold uppercase tracking-wider text-evnBlue">Bản đồ Chi tiết Phường / Xã</span>
              <span id="selected-province-title" class="text-sm font-bold text-evnBlue">Chưa chọn tỉnh thành</span>
            </div>

            <div class="flex-1 w-full rounded-xl overflow-hidden border border-slate-200 relative bg-[#f8fafc]">
              <!-- Map Viewport -->
              <div id="map-province-container" class="w-full h-full"></div>

              <!-- Empty placeholder overlay -->
              <div id="province-map-placeholder"
                class="absolute inset-0 bg-slate-50/95 backdrop-blur flex flex-col items-center justify-center p-6 text-center z-20 transition-all duration-300">
                <div
                  class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center text-blue-500 mb-3 animate-bounce">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                    stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                </div>
                <h4 class="text-sm font-bold text-evnBlue mb-1">Bản đồ chi tiết xã phường</h4>
                <p class="text-[11px] text-evnBlue max-w-xs">
                  Click chọn một tỉnh thành trên bản đồ Việt Nam (bên trái) hoặc chọn từ danh sách
                  để hiển thị sơ đồ phân cấp xã phường chi tiết.
                </p>
              </div>

              <!-- Loading spinner -->
              <div id="province-map-loader"
                class="absolute inset-0 bg-white/70 backdrop-blur flex flex-col items-center justify-center p-6 text-center z-10 hidden">
                <div class="w-10 h-10 border-4 border-blue-600 border-t-transparent rounded-full animate-spin mb-3">
                </div>
                <span class="text-xs font-semibold text-slate-600">Đang tải dữ liệu xã phường...</span>
              </div>

              <!-- Legend for Right Map -->
              <div
                class="absolute bottom-4 left-4 bg-white/90 backdrop-blur p-2.5 rounded-lg shadow border border-slate-100 text-left text-[10px] text-slate-600 z-10 space-y-1">
                <div class="font-semibold text-slate-800 mb-0.5">Bản đồ xã/phường</div>
                <div class="flex items-center gap-1.5">
                  <span
                    class="w-3 h-3 rounded bg-gradient-to-r from-pink-400 via-indigo-400 to-teal-400 inline-block"></span>
                  <span>Màu sắc riêng biệt theo xã/phường</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-3 h-3 rounded bg-[#db0d0d] inline-block"></span> Xã/phường đang
                  hover
                </div>
              </div>

              <!-- Example Agency Info Table Overlay (Added) -->
              <div id="agency-info-panel"
                class="absolute top-1 right-1 bg-white/95 backdrop-blur-md p-3 rounded-xl shadow-lg border border-slate-200 z-10 w-80 max-h-[60%] flex flex-col transition-all duration-300">
                <button id="toggle-agency-panel-btn"
                  class="flex justify-between items-center w-full mb-2 border-b border-slate-100 pb-2 hover:opacity-80 transition-opacity focus:outline-none">
                  <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                      class="w-4 h-4 text-blue-600">
                      <path fill-rule="evenodd"
                        d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z"
                        clip-rule="evenodd" />
                    </svg>
                    <span class="text-[11px] uppercase tracking-wider font-bold text-evnBlue">Thông tin Cơ quan (Ví
                      dụ)</span>
                  </div>
                  <svg id="agency-panel-arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                    stroke-width="2.5" stroke="currentColor"
                    class="w-4 h-4 text-slate-400 transition-transform duration-300 transform">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                  </svg>
                </button>

                <div id="agency-panel-body" class="overflow-y-auto transition-all duration-300">
                  <table class="w-full text-left border-collapse">
                    <thead>
                      <tr class="bg-slate-50 text-evnBlue text-[10px] uppercase tracking-wide">
                        <th class="px-2 py-1.5 border border-slate-200 font-semibold rounded-tl-lg">
                          Tên Trụ sở
                        </th>
                        <th class="px-2 py-1.5 border border-slate-200 font-semibold">Địa chỉ</th>
                        <th class="px-2 py-1.5 border border-slate-200 font-semibold rounded-tr-lg">
                          SĐT
                        </th>
                      </tr>
                    </thead>
                    <tbody class="text-[10px] text-slate-600">
                      <tr class="hover:bg-blue-50 transition-colors">
                        <td class="px-2 py-2 border border-slate-100 font-medium text-slate-800">
                          UBND Xã/Phường
                        </td>
                        <td class="px-2 py-2 border border-slate-100">Đang cập nhật...</td>
                        <td class="px-2 py-2 border border-slate-100">0236.111.222</td>
                      </tr>
                      <tr class="bg-slate-50/50 hover:bg-blue-50 transition-colors">
                        <td class="px-2 py-2 border border-slate-100 font-medium text-slate-800">
                          Công an Xã/Phường
                        </td>
                        <td class="px-2 py-2 border border-slate-100">Đang cập nhật...</td>
                        <td class="px-2 py-2 border border-slate-100">0236.333.444</td>
                      </tr>
                      <tr class="hover:bg-blue-50 transition-colors">
                        <td class="px-2 py-2 border border-slate-100 font-medium text-slate-800">
                          Trạm Y tế
                        </td>
                        <td class="px-2 py-2 border border-slate-100">Đang cập nhật...</td>
                        <td class="px-2 py-2 border border-slate-100">0236.555.666</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Our Services Section -->
    <section class="services-section min-h-screen flex flex-col justify-center" id="services">
      <div class="services-container">
        <span class="section-tag text-center">Văn bản pháp luật</span>
        <h2 class="section-title text-center">Hệ thống tra cứu văn bản pháp luật</h2>
        <div class="text-sm text-evnBlue text-center mb-4 mt-2">
          <p class="font-medium">Chọn hạng mục để xem</p>
          <p class="mt-1 text-orange-600">Cập nhật mới nhất tới tháng 07/2027</p>
        </div>

        <div class="services-grid">
          <!-- Card 1 -->
          <div class="service-card">
            <h3 class="service-title text-center">Hạng mục</h3>

            <ul class="bullet-list">
              <li class="cursor-pointer hover:text-orange-600 hover:font-bold hover:translate-x-5 transition-all">
                Doanh nghiệp
