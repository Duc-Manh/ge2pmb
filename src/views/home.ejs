                Sơn La
              </option>
              <option value="15_lao_cai" data-center="[103.972, 22.485]" data-zoom="8.5">
                Lào Cai
              </option>
              <option value="19_thai_nguyen" data-center="[105.845, 21.593]" data-zoom="9">
                Thái Nguyên
              </option>
              <option value="20_lang_son" data-center="[106.757, 21.852]" data-zoom="8.5">
                Lạng Sơn
              </option>
              <option value="22_quang_ninh" data-center="[107.242, 21.148]" data-zoom="8.5">
                Quảng Ninh
              </option>
              <option value="24_bac_ninh" data-center="[106.071, 21.185]" data-zoom="9.5">
                Bắc Ninh
              </option>
              <option value="25_phu_tho" data-center="[105.215, 21.325]" data-zoom="9">
                Phú Thọ
              </option>
              <option value="31_hai_phong" data-center="[106.683, 20.849]" data-zoom="9.5">
