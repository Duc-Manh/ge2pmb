<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Control Hub</title>
  <!-- Favicon & Icons -->
  <link rel="shortcut icon" href="/images/favicon.ico/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon.ico/apple-icon-180x180.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.ico/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon.ico/favicon-16x16.png" />
  <link rel="manifest" href="/images/favicon.ico/manifest.json" />
  <!-- SEO & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/tailwind.min.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="/css/board.css?v=<%= Date.now() %>">
</head>

<body
  class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col bg-[url('/images/home.jpg')] bg-cover bg-center bg-fixed">
  <!-- Backdrop Blur Layer for Glassmorphism effect -->
  <div class="fixed inset-0 bg-slate-100/90 backdrop-blur-sm z-0"></div>

  <!-- Navbar -->
  <nav class="bg-white/80 backdrop-blur-md shadow-sm border-b border-slate-200 fixed w-full z-20 top-0 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <!-- Logo -->
        <div class="flex items-center">
          <a href="/" class="flex-shrink-0 flex items-center gap-3 group">
            <img class="h-14 w-auto transition-transform group-hover:scale-105" src="/images/logo-ngang.png"
              alt="EVNGENCO2">
            <span class="font-bold text-lg text-evnBlue hidden sm:block border-l-2 border-slate-300 pl-3">Control
              Hub</span>
          </a>
        </div>

        <!-- Right side -->
        <div class="flex items-center gap-6">
          <!-- Search Icon (Mock) -->
          <button class="text-slate-400 hover:text-evnBlue transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>

          <!-- Notifications -->
          <button
            class="text-slate-400 hover:text-evnOrange transition-colors relative <%= typeof pendingCount !== 'undefined' && pendingCount > 0 ? 'animate-wiggle text-evnOrange' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <% if (typeof pendingCount !=='undefined' && pendingCount> 0) { %>
              <span class="absolute -top-1.5 -right-1.5 flex h-4 w-4 items-center justify-center">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-evnOrange opacity-75"></span>
                <span
                  class="relative inline-flex rounded-full h-4 w-4 bg-evnOrange border-2 border-white items-center justify-center text-[9px] font-bold text-white leading-none">
                  <%= pendingCount> 99 ? '99+' : pendingCount %>
                </span>
              </span>
              <% } %>
          </button>

          <!-- User Profile Dropdown -->
          <div class="relative group cursor-pointer">
            <div class="flex items-center gap-2 border-l pl-6 border-slate-200">

              <div class="hidden sm:block text-left">
                <p class="text-sm font-semibold text-slate-700 leading-tight">
                  <%= user.full_name %>
                </p>
                <p class="text-xs text-slate-500 leading-tight">Admin</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 text-slate-400 group-hover:text-evnBlue transition-colors" fill="none"
                viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>

            <!-- Dropdown Menu -->
            <div
              class="absolute right-0 mt-2 w-56 bg-white/95 backdrop-blur-md rounded-xl shadow-xl border border-slate-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-2 group-hover:translate-y-0 z-50">
              <div class="p-2 space-y-1">
                <a href="#"
                  class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 hover:bg-blue-50 hover:text-evnBlue rounded-lg transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  Hồ sơ cá nhân
                </a>
                <a href="#"
                  class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 hover:bg-blue-50 hover:text-evnBlue rounded-lg transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Cài đặt hệ thống
                </a>
                <div class="h-px bg-slate-100 my-2"></div>
                <a href="/logout"
                  class="flex items-center gap-3 px-3 py-2.5 text-sm text-red-600 hover:bg-red-50 rounded-lg transition-colors font-medium">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  Đăng xuất
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Hub Content -->
  <main class="flex-grow pt-28 pb-12 px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col items-center">

    <!-- Hero Greeting -->
    <div class="max-w-7xl w-full mb-10 opacity-0 animate-fade-in">
      <h1 class="text-4xl font-extrabold text-slate-800 tracking-tight">Xin chào, <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-evnBlue to-blue-500">
          <%= user.full_name %>!
        </span></h1>
      <p class="text-lg text-slate-500 mt-2">Hôm nay là một ngày tuyệt vời để đẩy nhanh tiến độ dự án.</p>

      <!-- Quick Status Pills -->
      <div class="flex flex-wrap gap-4 mt-6">
        <div
          class="bg-white/60 backdrop-blur-sm border border-white shadow-sm rounded-full px-4 py-1.5 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></span>
          <span class="text-sm font-medium text-slate-600">Hệ thống: Ổn định</span>
        </div>
        <div
          class="bg-white/60 backdrop-blur-sm border border-white shadow-sm rounded-full px-4 py-1.5 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-evnBlue" fill="none" viewBox="0 0 24 24"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <span class="text-sm font-medium text-slate-600">Dự án đang chạy: <b class="text-evnBlue">
              <%= typeof activeProjectCount !=='undefined' ? activeProjectCount : '0' %>
            </b></span>
        </div>
        <div
          class="bg-white/60 backdrop-blur-sm border border-white shadow-sm rounded-full px-4 py-1.5 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-evnOrange" fill="none" viewBox="0 0 24 24"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-sm font-medium text-slate-600">Nhiệm vụ cần duyệt: <b class="text-evnOrange">5</b></span>
        </div>
      </div>
    </div>

    <!-- Modules Grid (Control Hub) -->
    <div class="max-w-7xl w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Card 1 -->
      <a href="/project"
        class="group relative bg-white/80 backdrop-blur-xl border border-white rounded-3xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 opacity-0 animate-fade-in delay-100 flex flex-col h-full overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-blue-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="relative z-10">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-evnBlue to-blue-600 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300 mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-evnBlue transition-colors">Quản lý Dự án
          </h3>
          <p class="text-sm text-slate-500 leading-relaxed">Theo dõi tiến độ, tạo mới và phân bổ nguồn lực cho các dự án
            đang và sắp triển khai.</p>
        </div>
        <div
          class="mt-auto pt-6 relative z-10 flex items-center text-sm font-semibold text-evnBlue group-hover:translate-x-2 transition-transform duration-300">
          Truy cập phân hệ <span class="ml-2">→</span>
        </div>
      </a>

      <!-- Card 2 -->
      <a href="/bid"
        class="group relative bg-white/80 backdrop-blur-xl border border-white rounded-3xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 opacity-0 animate-fade-in delay-200 flex flex-col h-full overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-orange-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="relative z-10">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-orange-500 to-amber-500 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300 mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-orange-600 transition-colors">Hồ sơ Đấu thầu
          </h3>
          <p class="text-sm text-slate-500 leading-relaxed">Quản lý các gói thầu, văn bản pháp lý, đánh giá năng lực nhà
            thầu minh bạch.</p>
        </div>
        <div
          class="mt-auto pt-6 relative z-10 flex items-center text-sm font-semibold text-orange-600 group-hover:translate-x-2 transition-transform duration-300">
          Truy cập phân hệ <span class="ml-2">→</span>
        </div>
      </a>

      <!-- Card 3 -->
      <a href="#"
        class="group relative bg-white/80 backdrop-blur-xl border border-white rounded-3xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 opacity-0 animate-fade-in delay-300 flex flex-col h-full overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-emerald-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="relative z-10">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-green-500 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300 mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-emerald-600 transition-colors">Kế toán & Tài
            chính</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Phê duyệt giải ngân, theo dõi dòng tiền dự án và báo cáo tài
            chính nội bộ.</p>
        </div>
        <div
          class="mt-auto pt-6 relative z-10 flex items-center text-sm font-semibold text-emerald-600 group-hover:translate-x-2 transition-transform duration-300">
          Truy cập phân hệ <span class="ml-2">→</span>
        </div>
      </a>

      <!-- Card 4 -->
      <a href="/employ"
        class="group relative bg-white/80 backdrop-blur-xl border border-white rounded-3xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 opacity-0 animate-fade-in delay-400 flex flex-col h-full overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-purple-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="relative z-10">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-600 to-indigo-600 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300 mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-purple-600 transition-colors">Quản trị Nhân
            sự</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Phân quyền tài khoản, điều phối cán bộ kỹ thuật cho các hạng
            mục thi công.</p>
        </div>
        <div
          class="mt-auto pt-6 relative z-10 flex items-center text-sm font-semibold text-purple-600 group-hover:translate-x-2 transition-transform duration-300">
          Truy cập phân hệ <span class="ml-2">→</span>
        </div>
      </a>

      <!-- Card 5 -->
      <a href="/save"
        class="group relative bg-white/80 backdrop-blur-xl border border-white rounded-3xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 opacity-0 animate-fade-in delay-500 flex flex-col h-full overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-rose-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="relative z-10">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-rose-500 to-pink-600 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300 mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-rose-600 transition-colors">Văn thư - Lưu
            trữ</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Số hóa tài liệu, công văn đến/đi và kho lưu trữ thiết kế bản
            vẽ kỹ thuật.</p>
        </div>
        <div
          class="mt-auto pt-6 relative z-10 flex items-center text-sm font-semibold text-rose-600 group-hover:translate-x-2 transition-transform duration-300">
          Truy cập phân hệ <span class="ml-2">→</span>
        </div>
      </a>

      <!-- Card 6 -->
      <a href="#"
        class="group relative bg-white/80 backdrop-blur-xl border border-white rounded-3xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 opacity-0 animate-fade-in delay-600 flex flex-col h-full overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-sky-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="relative z-10">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-sky-400 to-cyan-500 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300 mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-sky-600 transition-colors">Báo cáo Thống kê
          </h3>
          <p class="text-sm text-slate-500 leading-relaxed">Trích xuất biểu đồ số liệu tiến độ, biểu đồ giải ngân phục
            vụ Ban lãnh đạo.</p>
        </div>
        <div
          class="mt-auto pt-6 relative z-10 flex items-center text-sm font-semibold text-sky-600 group-hover:translate-x-2 transition-transform duration-300">
          Truy cập phân hệ <span class="ml-2">→</span>
        </div>
      </a>

    </div>
  </main>
  <script src="/js/board.js?v=<%= Date.now() %>"></script>
</body>

</html>