    <div class="header-container">
      <a href="#" class="logo">
        <img src="/images/logo-ngang.png" alt="Logo" class="logo-img" />
      </a>
      <nav class="nav-menu" id="nav-menu">
        <a href="#home" class="nav-link">Trang chủ</a>
        <a href="#national-map-section" class="nav-link">Địa giới hành chính</a>
        <a href="#services" class="nav-link">Văn bản pháp luật</a>
        <a href="#projects" class="nav-link">Lĩnh vực hoạt động</a>
        <a href="#contact" class="nav-link">Liên hệ công việc</a>
      </nav>
      <a href="/login" class="btn-get-template">Đăng nhập</a>
    </div>
  </header>

  <!-- Main Body Content -->
  <main>
    <!-- 1. Hero Section -->
    <div class="hero-3d-stage">
      <section class="hero-section" id="home">
        <!-- Blueprint grid lines -->
        <div class="blueprint-grid">
          <div class="blueprint-crosshair-h"></div>
          <div class="blueprint-crosshair-v"></div>
          <div class="blueprint-coordinates"></div>
        </div>

        <div class="hero-container">
          <div class="hero-left">
            <h1 class="hero-title">
              Ban quản lý dự án<br /><span class="text-evnBlue">EVN</span><span class="text-evnRed italic">GENCO2</span>
            </h1>
            <p class="hero-desc">
              Đơn vị trực thuộc Tổng Công ty Phát điện 2, có chức năng quản lý, triển khai các dự
              án đầu tư và phát triển, đảm bảo tiến độ, chất lượng, an toàn, hiệu quả.
            </p>
            <div class="hero-actions">
              <a href="#projects" class="btn-primary">Lĩnh vực hoạt động</a>
              <a href="#contact" class="btn-outline">Liên hệ công việc</a>
            </div>
          </div>
          <div class="hero-right">
            <div class="hero-image-card">
              <img src="/images/home.jpg" alt="Trụ sở" />
              <div class="hero-card-caption">
                <span class="caption-title">Trụ sở Ban quản lý dự án EVNGENCO2</span>
                <span class="caption-subtitle">143 Xô Viết Nghệ Tĩnh, Cẩm Lệ, Đà Nẵng</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
    <!-- /.hero-3d-stage -->

    <!-- National Map Section -->
    <section id="national-map-section" class="map-reveal-section pt-20 pb-20 bg-white border-y border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Main Panel Header -->
        <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
          <div class="text-left">
            <h3 class="text-2xl font-bold text-evnBlue">Hệ thống Địa giới Hành chính Việt Nam</h3>
            <p class="text-sm text-evnBlue">
              Xem ranh giới hành chính toàn quốc (2D) và chi tiết phân cấp xã/phường khi lựa chọn.
            </p>
          </div>
          <!-- Selector for Province -->
          <div class="flex items-center gap-2">
            <label for="map-province-select" class="text-sm font-semibold text-evnBlue">Chọn địa bàn:</label>
            <select id="map-province-select"
              class="border border-evnBlue rounded-md p-1.5 text-xs bg-white focus:outline-none focus:border-blue-500">
              <option value="all" data-center="[106.660, 16.047]" data-zoom="5">
                -- Chọn Tỉnh / Thành phố --
              </option>
              <option value="01_ha_noi" data-center="[105.834, 21.028]" data-zoom="9">
                Hà Nội
              </option>
              <option value="04_cao_bang" data-center="[106.263, 22.668]" data-zoom="8.5">
