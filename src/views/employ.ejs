<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản trị Nhân sự - EVNGENCO2</title>
  <!-- SEO & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/tailwind.min.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="/css/employ.css?v=<%= Date.now() %>">
</head>

<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">
  <!-- Navbar -->
  <nav class="bg-white shadow-sm border-b border-slate-200 fixed w-full z-20 top-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center gap-4">
          <a href="/board"
            class="text-evnBlue hover:text-orange-600 transition-colors flex items-center gap-1 font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd"
                d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                clip-rule="evenodd" />
            </svg>
            Quay lại Hub
          </a>
          <div class="h-6 w-px bg-slate-300"></div>
          <span class="font-bold text-lg text-evnBlue">Phân hệ Quản trị Nhân sự</span>
        </div>

        <div class="flex items-center gap-6">
          <!-- Notifications -->
          <button
            class="text-slate-400 hover:text-evnOrange transition-colors relative <%= typeof pendingCount !== 'undefined' && pendingCount > 0 ? 'animate-wiggle text-evnOrange' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <% if (typeof pendingCount !=='undefined' && pendingCount> 0) { %>
              <span class="absolute -top-1.5 -right-1.5 flex h-4 w-4 items-center justify-center">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-evnOrange opacity-75"></span>
                <span
                  class="relative inline-flex rounded-full h-4 w-4 bg-evnOrange border-2 border-white items-center justify-center text-[9px] font-bold text-white leading-none">
                  <%= pendingCount> 99 ? '99+' : pendingCount %>
                </span>
              </span>
              <% } %>
          </button>

          <!-- User Profile Dropdown -->
          <div class="relative group cursor-pointer">
            <div class="flex items-center gap-2 border-l pl-6 border-slate-200">

              <div class="hidden sm:block text-left">
                <p class="text-sm font-semibold text-slate-700 leading-tight">
                  <%= user.full_name %>
                </p>
                <p class="text-xs text-slate-500 leading-tight">Admin</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 text-slate-400 group-hover:text-evnBlue transition-colors" fill="none"
                viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>

            <!-- Dropdown Menu -->
            <div
              class="absolute right-0 mt-2 w-56 bg-white/95 backdrop-blur-md rounded-xl shadow-xl border border-slate-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-2 group-hover:translate-y-0 z-50">
              <div class="p-2 space-y-1">
                <a href="#"
                  class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 hover:bg-blue-50 hover:text-evnBlue rounded-lg transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  Hồ sơ cá nhân
                </a>
                <a href="#"
                  class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 hover:bg-blue-50 hover:text-evnBlue rounded-lg transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Cài đặt hệ thống
                </a>
                <div class="h-px bg-slate-100 my-2"></div>
                <a href="/logout"
                  class="flex items-center gap-3 px-3 py-2.5 text-sm text-red-600 hover:bg-red-50 rounded-lg transition-colors font-medium">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  Đăng xuất
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-grow pt-24 pb-12 px-2 sm:px-4 lg:px-6 max-w-7xl mx-auto w-full">

    <div class="flex justify-between items-end mb-8">
      <div>
        <h1 class="text-2xl font-extrabold text-evnBlue">Danh sách Cán bộ</h1>
        <p class="text-evnBlue mt-1">Quản lý tài khoản và phân quyền cán bộ tham gia dự án.</p>
      </div>
      <button
        class="bg-evnBlue hover:bg-orange-600 text-white text-sm px-5 py-2.5 rounded-lg shadow-md font-medium transition-colors flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Thêm admin
      </button>
    </div>

    <!-- Table Container -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-evnBlue text-white text-xs uppercase tracking-wider border border-evnBlue">
              <th class="px-6 py-4 font-semibold transition-colors duration-300">Họ và tên</th>
              <th class="px-6 py-4 font-semibold transition-colors duration-300">Email</th>
              <th class="px-6 py-4 font-semibold transition-colors duration-300">Mật khẩu</th>
              <th class="px-6 py-4 font-semibold transition-colors duration-300">Số điện thoại</th>
              <th class="px-6 py-4 font-semibold transition-colors duration-300">Phòng ban</th>
              <th class="px-6 py-4 font-semibold transition-colors duration-300">Chức vụ</th>
              <th class="px-6 py-4 font-semibold transition-colors duration-300">Vai trò</th>
              <th class="px-6 py-4 font-semibold text-right transition-colors duration-300">Thao tác</th>
            </tr>
          </thead>
          <% const predefinedRooms=[ 'Ban Giám Đốc' , 'Tổ chức Hành chính' , 'Kinh tế Kế hoạch' , 'Vật tư Thiết bị'
            , 'Kỹ thuật An toàn' , 'Tài chính Kế toán' ]; const emps=(typeof employees !=='undefined' ) ? employees :
            []; %>

            <% predefinedRooms.forEach((roomName, index)=> { %>
              <tbody class="divide-y divide-slate-100 text-sm">
                <% const roomEmps=emps.filter(e=> e.room === roomName); %>
                  <tr
                    class="bg-slate-100 hover:bg-blue-100/70 cursor-pointer transition-colors duration-300 border-t border-slate-200"
                    onclick="toggleRoom('room-<%= index %>')">
                    <td colspan="8"
                      class="px-6 py-3 font-semibold text-slate-700 select-none relative overflow-hidden group">
                      <div id="particles-room-<%= index %>"
                        class="particles-container absolute inset-0 z-0 pointer-events-none opacity-60 group-hover:opacity-100 transition-opacity duration-500">
                      </div>
                      <div class="relative z-10 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-evnBlue" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                          </svg>
                          <%= roomName %>
                        </div>
                        <svg id="icon-room-<%= index %>" xmlns="http://www.w3.org/2000/svg"
                          class="h-5 w-5 text-slate-500 transition-transform duration-200 transform <%= roomEmps.length > 0 ? '' : 'rotate-180' %>"
                          fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                        </svg>
                      </div>
                    </td>
                  </tr>

                  <% if (roomEmps.length> 0) { %>
                    <% roomEmps.forEach(emp=> { %>
                      <tr class="hover:bg-slate-50 transition-colors room-<%= index %>">
                        <td class="px-6 py-4">
                          <div class="flex items-center gap-3">
                            <div class="font-medium text-slate-800">
                              <%= emp.full_name || 'N/A' %>
                            </div>
                          </div>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.email %>
                        </td>
                        <td class="px-6 py-4 text-slate-600 truncate max-w-[150px]" title="<%= emp.password %>">
                          <%= emp.password %>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.phone || 'N/A' %>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.room || 'N/A' %>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.position || 'N/A' %>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.role==1 ? 'User' : (emp.role==2 ? 'Admin' : 'N/A' ) %>
                        </td>
                        <td class="px-4 py-4 text-right">
                          <button type="button"
                            class="text-slate-400 hover:text-evnBlue transition-colors px-2 btn-edit-employee"
                            data-email="<%= emp.email %>" data-fullname="<%= emp.full_name || '' %>"
                            data-phone="<%= emp.phone || '' %>" data-room="<%= emp.room || '' %>"
                            data-position="<%= emp.position || '' %>" data-role="<%= emp.role || '' %>">Sửa</button>
                          <button class="text-slate-400 hover:text-red-600 transition-colors px-2">Xóa</button>
                        </td>
                      </tr>
                      <% }) %>
                        <% } else { %>
                          <tr class="hidden room-<%= index %>">
                            <td colspan="8" class="px-6 py-4 text-center text-slate-500 italic">Không có cán bộ</td>
                          </tr>
                          <% } %>
              </tbody>
              <% }) %>

                <% const otherEmps=emps.filter(e=> !predefinedRooms.includes(e.room));
                  if (otherEmps.length > 0) {
                  %>
                  <tbody class="divide-y divide-slate-100 text-sm">
                    <tr
                      class="bg-slate-100 hover:bg-blue-100/70 cursor-pointer transition-colors duration-300 border-t border-slate-200"
                      onclick="toggleRoom('room-other')">
                      <td colspan="8"
                        class="px-6 py-3 font-semibold text-slate-700 select-none relative overflow-hidden group">
                        <div id="particles-room-other"
                          class="particles-container absolute inset-0 z-0 pointer-events-none opacity-60 group-hover:opacity-100 transition-opacity duration-500">
                        </div>
                        <div class="relative z-10 flex items-center justify-between">
                          <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-evnBlue" fill="none"
                              viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Khác
                          </div>
                          <svg id="icon-room-other" xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-slate-500 transition-transform duration-200 transform" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                          </svg>
                        </div>
                      </td>
                    </tr>
                    <% otherEmps.forEach(emp=> { %>
                      <tr class="hover:bg-slate-50 transition-colors room-other">
                        <td class="px-6 py-4">
                          <div class="flex items-center gap-3">
                            <div class="font-medium text-slate-800">
                              <%= emp.full_name || 'N/A' %>
                            </div>
                          </div>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.email %>
                        </td>
                        <td class="px-6 py-4 text-slate-600 truncate max-w-[150px]" title="<%= emp.password %>">
                          <%= emp.password %>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.phone || 'N/A' %>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.room || 'N/A' %>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.position || 'N/A' %>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= emp.role==1 ? 'User' : (emp.role==2 ? 'Admin' : 'N/A' ) %>
                        </td>
                        <td class="px-4 py-4 text-right">
                          <button type="button"
                            class="text-evnBlue hover:text-orange-600 transition-colors px-2 btn-edit-employee"
                            data-email="<%= emp.email %>" data-fullname="<%= emp.full_name || '' %>"
                            data-phone="<%= emp.phone || '' %>" data-room="<%= emp.room || '' %>"
                            data-position="<%= emp.position || '' %>" data-role="<%= emp.role || '' %>">Sửa</button>
                          <button class="text-evnBlue hover:text-orange-600 transition-colors px-2">Xóa</button>
                        </td>
                      </tr>
                      <% }) %>
                  </tbody>
                  <% } %>
        </table>
      </div>
    </div>

  </main>

  <!-- Edit Modal -->
  <div id="editModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog"
    aria-modal="true">
    <!-- Overlay -->
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" aria-hidden="true"
      onclick="closeEditModal()"></div>

    <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
      <div
        class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
        <form id="editForm">
          <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
            <div class="sm:flex sm:items-start">
              <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                <h3 class="text-xl font-bold leading-6 text-slate-800 mb-6" id="modal-title">Chỉnh sửa thông tin</h3>

                <div class="space-y-4">
                  <!-- Email (Readonly) -->
                  <div>
                    <label for="edit_email" class="block text-sm font-medium text-slate-700">Email</label>
                    <input type="email" id="edit_email" name="email" readonly
                      class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-slate-500 shadow-sm focus:outline-none sm:text-sm">
                  </div>

                  <!-- Full Name -->
                  <div>
                    <label for="edit_full_name" class="block text-sm font-medium text-slate-700">Họ và tên <span
                        class="text-red-500">*</span></label>
                    <input type="text" id="edit_full_name" name="full_name" required
                      class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-800 shadow-sm focus:border-evnBlue focus:outline-none focus:ring-1 focus:ring-evnBlue sm:text-sm">
                  </div>

                  <!-- Password -->
                  <div>
                    <label for="edit_password" class="block text-sm font-medium text-slate-700">Mật khẩu (Bỏ trống nếu
                      không đổi)</label>
                    <input type="text" id="edit_password" name="password"
                      class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-800 shadow-sm focus:border-evnBlue focus:outline-none focus:ring-1 focus:ring-evnBlue sm:text-sm">
                  </div>

                  <!-- Phone -->
                  <div>
                    <label for="edit_phone" class="block text-sm font-medium text-slate-700">Số điện thoại <span
                        class="text-red-500">*</span></label>
                    <input type="text" id="edit_phone" name="phone" required
                      class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-800 shadow-sm focus:border-evnBlue focus:outline-none focus:ring-1 focus:ring-evnBlue sm:text-sm">
                  </div>

                  <!-- Room -->
                  <div>
                    <label for="edit_room" class="block text-sm font-medium text-slate-700">Phòng ban <span
                        class="text-red-500">*</span></label>
                    <select id="edit_room" name="room" required
                      class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-800 shadow-sm focus:border-evnBlue focus:outline-none focus:ring-1 focus:ring-evnBlue sm:text-sm">
                      <option value="">-- Chọn phòng ban --</option>
                      <option value="Ban Giám Đốc">Ban Giám Đốc</option>
                      <option value="Tổ chức Hành chính">Tổ chức Hành chính</option>
                      <option value="Kinh tế Kế hoạch">Kinh tế Kế hoạch</option>
                      <option value="Vật tư Thiết bị">Vật tư Thiết bị</option>
                      <option value="Kỹ thuật An toàn">Kỹ thuật An toàn</option>
                      <option value="Tài chính Kế toán">Tài chính Kế toán</option>
                    </select>
                  </div>

                  <!-- Position -->
                  <div>
                    <label for="edit_position" class="block text-sm font-medium text-slate-700">Chức vụ <span
                        class="text-red-500">*</span></label>
                    <select id="edit_position" name="position" required
                      class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-800 shadow-sm focus:border-evnBlue focus:outline-none focus:ring-1 focus:ring-evnBlue sm:text-sm">
                      <option value="">-- Chọn chức vụ --</option>
                      <option value="Giám Đốc">Giám Đốc</option>
                      <option value="Q. Giám Đốc">Q. Giám Đốc</option>
                      <option value="Phó Giám Đốc">Phó Giám Đốc</option>
                      <option value="Trưởng phòng">Trưởng phòng</option>
                      <option value="Phụ trách phòng">Phụ trách phòng</option>
                      <option value="Phó Trưởng phòng">Phó Trưởng phòng</option>
                      <option value="Chuyên viên">Chuyên viên</option>
                    </select>
                  </div>

                  <!-- Role -->
                  <div>
                    <label for="edit_role" class="block text-sm font-medium text-slate-700">Vai trò</label>
                    <select id="edit_role" name="role"
                      class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-800 shadow-sm focus:border-evnBlue focus:outline-none focus:ring-1 focus:ring-evnBlue sm:text-sm">
                      <option value="1">User</option>
                      <option value="2">Admin</option>
                    </select>
                  </div>

                </div>
              </div>
            </div>
          </div>
          <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 rounded-b-2xl">
            <button type="submit"
              class="inline-flex w-full justify-center rounded-lg bg-evnBlue px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-800 sm:ml-3 sm:w-auto transition-colors">Xác
              nhận</button>
            <button type="button" onclick="closeEditModal()"
              class="mt-3 inline-flex w-full justify-center rounded-lg bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto transition-colors">Hủy</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- tsParticles -->
  <script src="https://cdn.jsdelivr.net/npm/tsparticles@2/tsparticles.bundle.min.js"></script>
  <script src="/js/employ.js?v=<%= Date.now() %>"></script>
</body>

</html>