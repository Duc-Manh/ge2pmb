                Hưng Yên
              </option>
              <option value="37_ninh_binh" data-center="[105.973, 20.252]" data-zoom="9.5">
                Ninh Bình
              </option>
              <option value="38_thanh_hoa" data-center="[105.782, 19.808]" data-zoom="8.5">
                Thanh Hóa
              </option>
              <option value="40_nghe_an" data-center="[105.681, 18.673]" data-zoom="8.5">
                Nghệ An
              </option>
              <option value="42_ha_tinh" data-center="[105.906, 18.355]" data-zoom="9">
                Hà Tĩnh
              </option>
              <option value="44_quang_tri" data-center="[107.100, 16.750]" data-zoom="9">
                Quảng Trị
              </option>
              <option value="46_hue" data-center="[107.590, 16.467]" data-zoom="9">
                Thừa Thiên Huế
              </option>
              <option value="48_da_nang" data-center="[108.212, 16.031]" data-zoom="10">
                Đà Nẵng
              </option>
              <option value="51_quang_ngai" data-center="[108.799, 15.120]" data-zoom="9">
                Quảng Ngãi
              </option>
              <option value="52_gia_lai" data-center="[108.012, 13.985]" data-zoom="8.5">
                Gia Lai
              </option>
              <option value="56_khanh_hoa" data-center="[109.196, 12.238]" data-zoom="9">
